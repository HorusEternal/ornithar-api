APP_ENV=dev
APP_SECRET=ornithar-local-development-secret
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

# Local Docker PostgreSQL credentials. Do not use these values in production.
POSTGRES_DB=ornithar
POSTGRES_USER=ornithar
POSTGRES_PASSWORD=ornithar
DATABASE_URL="postgresql://ornithar:ornithar@postgres:5432/ornithar?serverVersion=18&charset=utf8"
